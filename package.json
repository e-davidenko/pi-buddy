{
  "name": "@euhenio/pi-buddy",
  "version": "2.4.6",
  "description": "A terminal tamagotchi for pi: animated pixel pets that react to your coding agent, with English and Russian speech",
  "keywords": [
    "pi-package",
    "pi-extension",
    "buddy",
    "tamagotchi"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "docs/behavior.md",
    "preview.png",
    "media/demo.gif",
    "README.ru.md",
    "docs/behavior.ru.md",
    "docs/localization.md",
    "media/demo.en.gif"
  ],
  "pi": {
    "extensions": [
      "./extensions/buddy.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "author": "euhenio",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
